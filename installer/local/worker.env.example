# Install as /etc/kalamapp-install-worker.env, owned by root, mode 0600.
SUPABASE_URL=https://REPLACE_WITH_CONTROL_API
SUPABASE_SERVICE_ROLE_KEY=REPLACE_LOCALLY
KALAMAPP_RELEASES_ROOT=/var/lib/kalamapp-install-worker/releases
KALAMAPP_TRUST_KEY=/etc/kalamapp/release-signing.pub
KALAMAPP_WORK_ROOT=/var/lib/kalamapp-install-worker/jobs
# PostgreSQL service definitions and credentials are private worker-side files.
PGSERVICE=local_export_source
PGSERVICEFILE=/etc/kalamapp/export-pg-service.conf
PGPASSFILE=/etc/kalamapp/export.pgpass
# Recipient public keys come from installation records. Private recovery keys never reach this worker.
KALAMAPP_TRANSFER_SIGNING_KEY=/etc/kalamapp/transfer-signing.key
