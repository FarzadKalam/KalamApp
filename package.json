{
  "name": "tazesystem",
  "private": true,
  "version": "2.69.0.0.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "test": "vitest run",
    "test:critical-ui": "vitest run components/moduleShow/PrintSection.test.tsx components/SmartForm.test.tsx utils/notificationViewModels.test.ts utils/webForms.test.ts utils/printTemplates/printPerformance.test.ts",
    "test:module-show": "vitest run components/moduleShow/PrintSection.test.tsx",
    "test:notifications": "vitest run utils/notification utils/messageReceipts.test.ts utils/uiNotificationOverlayStore.test.ts hooks/useCommunicationTimeline.test.tsx components/notifications/SnoozeScheduleModal.test.ts",
    "test:task-status": "vitest run utils/processTaskStatusOptions.test.ts",
    "test:processes": "vitest run utils/taskRuntimeEvents.test.ts",
    "test:smart-form": "vitest run components/SmartForm.test.tsx utils/webForms.test.ts",
    "test:view-filters": "vitest run components/workflows/WorkflowConditionsGroup.test.tsx",
    "test:perf": "vitest run utils/notificationViewModels.test.ts components/SmartForm.test.tsx",
    "test:image-transform": "powershell -ExecutionPolicy Bypass -File ./scripts/test-image-transform.ps1",
    "preview": "vite preview",
    "db:sql": "powershell -ExecutionPolicy Bypass -File ./scripts/run-db-sql.ps1",
    "db:phase116": "powershell -ExecutionPolicy Bypass -File ./scripts/run-db-sql.ps1 -SqlFile ./database_v1_phase116_leave_requests_datetime_and_requester_fields.sql",
    "db:migrate:server": "powershell -ExecutionPolicy Bypass -File ./scripts/run-server-db-migrations.ps1",
    "db:migrate:server:list": "powershell -ExecutionPolicy Bypass -File ./scripts/run-server-db-migrations.ps1 -ListPending",
    "db:migrate:server:latest": "powershell -ExecutionPolicy Bypass -File ./scripts/run-server-db-migrations.ps1 -LatestOnly",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1",
    "deploy:prod:skip-build": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1 -SkipBuild",
    "deploy:function": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-supabase-function.ps1",
    "deploy:function:all": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-supabase-function.ps1 -All",
    "deploy:function:list": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-supabase-function.ps1 -List",
    "deploy:monitor": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-server-monitor.ps1"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.7.6",
    "@refinedev/antd": "^5.37.0",
    "@refinedev/core": "^4.50.0",
    "@refinedev/react-router-v6": "^4.5.0",
    "@refinedev/supabase": "^5.8.0",
    "@supabase/supabase-js": "^2.94.1",
    "@tanstack/react-virtual": "^3.13.25",
    "@tiptap/extension-color": "^3.20.4",
    "@tiptap/extension-highlight": "^3.20.4",
    "@tiptap/extension-image": "^3.20.4",
    "@tiptap/extension-link": "^3.20.4",
    "@tiptap/extension-placeholder": "^3.20.4",
    "@tiptap/extension-table": "^3.20.4",
    "@tiptap/extension-table-cell": "^3.20.4",
    "@tiptap/extension-table-header": "^3.20.4",
    "@tiptap/extension-table-row": "^3.20.4",
    "@tiptap/extension-text-align": "^3.20.4",
    "@tiptap/extension-text-style": "^3.20.4",
    "@tiptap/extension-underline": "^3.20.4",
    "@tiptap/html": "^3.20.4",
    "@tiptap/pm": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "@types/leaflet": "^1.9.21",
    "@xyflow/react": "^12.11.0",
    "antd": "^5.29.3",
    "antd-jalali": "^2.0.1",
    "dayjs": "^1.11.19",
    "dompurify": "^3.3.3",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.40.0",
    "html5-qrcode": "^2.3.8",
    "jalaliday": "^3.1.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.19.0",
    "react": "^18.3.1",
    "react-date-object": "^2.1.9",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-leaflet": "^4.2.1",
    "react-multi-date-picker": "^4.5.2",
    "react-router-dom": "6.22.3",
    "web-vitals": "^5.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.2"
  }
}
