DEPLOY_HOST=194.5.175.192
DEPLOY_PORT=22
DEPLOY_USER=deploy
# Optional: private SSH key used by local deploy scripts. Relative paths are resolved from repo root.
# DEPLOY_SSH_KEY_PATH=C:\Users\YourUser\Downloads\private-key-file.pem
DEPLOY_PATH=/var/www/kalamapp
# Optional: enable only if your ssh client supports ControlMaster/ControlPath correctly.
# DEPLOY_USE_SHARED_SSH=false

# Optional Supabase Edge Functions deploy settings
# Required only if you use `npm run deploy:function`
# Example target on self-hosted Supabase:
# DEPLOY_FUNCTIONS_PATH=/opt/supabase/volumes/functions
# DEPLOY_FUNCTIONS_COMPOSE_DIR=/opt/supabase
# DEPLOY_FUNCTIONS_COMPOSE_FILE=docker-compose.yml
# DEPLOY_FUNCTIONS_SERVICE=functions
# DEPLOY_FUNCTIONS_FILES_WITH_SUDO=false
# DEPLOY_FUNCTIONS_RESTART_WITH_SUDO=false

# Optional database migration settings for scripts/run-server-db-migrations.ps1
# If omitted, the script falls back to DEPLOY_USER and the defaults below.
# DB_MIGRATE_SSH_USER=root
# DB_MIGRATE_REMOTE_DIR=/tmp/kalamapp-db-migrations
# DB_MIGRATE_CONTAINER=supabase-db
# DB_MIGRATE_DATABASE=postgres
# DB_MIGRATE_DB_USER=supabase_admin
# DB_MIGRATE_HISTORY_TABLE=public.app_schema_migrations
# DB_MIGRATE_USE_SUDO=false
# First run only: mark old migrations as already applied, then execute newer files.
# Example for your current server after phase109:
# DB_MIGRATE_BASELINE_PHASE=109
# Or use a specific file instead:
# DB_MIGRATE_BASELINE_FILE=database_v1_phase109_web_forms_attendance_occurred_at.sql
