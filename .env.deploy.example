# Copy this file to .env.deploy and fill in your server details.
# Build-time app envs such as VITE_SUPABASE_URL stay in .env.local or your shell.

DEPLOY_HOST=your-server-ip
DEPLOY_PORT=22
DEPLOY_USER=deploy
DEPLOY_PATH=/var/www/kalamapp
DEPLOY_KEEP_RELEASES=5

# Optional
# DEPLOY_BUILD_COMMAND=npm run build
# DEPLOY_ARCHIVE_NAME=kalamapp-dist.tar.gz
# Supabase Edge Functions deploy (self-hosted)
# Example if your self-hosted Supabase lives under /opt/kalamapp-supabase:
# DEPLOY_FUNCTIONS_PATH=/opt/kalamapp-supabase/volumes/functions
# DEPLOY_FUNCTIONS_COMPOSE_DIR=/opt/kalamapp-supabase
# DEPLOY_FUNCTIONS_COMPOSE_FILE=docker-compose.yml
# DEPLOY_FUNCTIONS_SERVICE=functions
# DEPLOY_FUNCTIONS_FILES_WITH_SUDO=false
# DEPLOY_FUNCTIONS_RESTART_WITH_SUDO=false
# DEPLOY_FUNCTIONS_ARCHIVE_NAME=kalamapp-supabase-functions.tar.gz
