[general]
static=yes
writeprotect=yes
clearglobalvars=no

; Tenant-isolated internal & outbound call router.
; Endpoint IDs are strictly namespaced in Supabase as k_<12hex>_<ext>.
[kalam-org-router]
exten => _X.,1,NoOp(KalamApp tenant call from ${CALLERID(all)} to ${EXTEN} via ${CHANNEL(pjsip,endpoint)})
 same => n,Set(KALAM_NS=${CUT(CHANNEL(pjsip,endpoint),_,1-2)})
 same => n,GotoIf($["${KALAM_NS}" = ""]?reject)
 same => n,Set(TARGET_EP=${KALAM_NS}_${EXTEN})
 same => n,GotoIf($["${PJSIP_ENDPOINT(${TARGET_EP},aors)}" != ""]?internal:outbound)
 same => n(internal),Dial(PJSIP/${TARGET_EP},45,TtKk)
 same => n,Hangup()
 same => n(outbound),Set(ORG_TRUNK=${SHELL(curl -s --max-time 2 -H "x-kalam-voip-secret: ${KALAMAPP_VOIP_INTERNAL_SECRET}" "${KALAMAPP_WEBHOOK_URL}?action=resolve_trunk&ns=${KALAM_NS}&ext=${EXTEN}" | tr -d '\r\n')})
 same => n,GotoIf($["${ORG_TRUNK}" != ""]?dialtrunk:notrunk)
 same => n(dialtrunk),Dial(PJSIP/${EXTEN}@${ORG_TRUNK},60,Tt)
 same => n,Hangup()
 same => n(notrunk),Playback(ss-noservice)
 same => n,Hangup()
 same => n(reject),Hangup()

; Inbound calls from tenant trunk contexts
[from-trunk]
exten => _.,1,NoOp(Inbound call on trunk ${CHANNEL(pjsip,endpoint)} DID ${EXTEN})
 same => n,Hangup()

; Each external account has one generated UUID namespace. No cross-tenant trunk resolver is used.
[taze-external-out]
exten => _[+*#0-9]!,1,Set(BRIDGE_EP=${CHANNEL(pjsip,endpoint)})
 same => n,Set(BRIDGE_PREFIX=${CUT(BRIDGE_EP,_,1-2)})
 same => n,GotoIf($[${REGEX("^b_[0-9a-f]{32}_browser$" ${BRIDGE_EP})} != 1]?reject)
 same => n,GotoIf($["${FILTER(0-9+*#,${EXTEN})}" != "${EXTEN}"]?reject)
 same => n,Dial(PJSIP/${EXTEN}@${BRIDGE_PREFIX}_provider,60)
 same => n,Hangup()
 same => n(reject),Hangup(21)

; Provider INVITEs are matched to their registration's unique Contact 'line' parameter.
; No shared provider-IP identification or caller-supplied destination selects the browser.
[taze-external-in]
exten => _.,1,Set(BRIDGE_EP=${CHANNEL(pjsip,endpoint)})
 same => n,Set(BRIDGE_PREFIX=${CUT(BRIDGE_EP,_,1-2)})
 same => n,GotoIf($[${REGEX("^b_[0-9a-f]{32}_provider$" ${BRIDGE_EP})} != 1]?reject)
 same => n,Dial(PJSIP/${BRIDGE_PREFIX}_browser,45)
 same => n,Hangup()
 same => n(reject),Hangup(21)
