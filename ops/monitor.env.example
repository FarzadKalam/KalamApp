# این فایل را روی سرور به /etc/kalamapp-monitor.env کپی کنید و مقادیر را وارد کنید.
# هرگز این مقادیر را در git ثبت نکنید.
MONITOR_BALE_BOT_TOKEN=
MONITOR_BALE_CHAT_ID=

# یک URL heartbeat از سرویس مانیتورینگِ خارج از این سرور.
# اگر سرور کاملاً قطع شود، نرسیدن heartbeat هشدار بیرونی ایجاد می‌کند.
MONITOR_HEARTBEAT_URL=

MONITOR_DISK_PATH=/var/lib/docker
MONITOR_DISK_WARNING_PERCENT=80
MONITOR_DISK_CRITICAL_PERCENT=90
MONITOR_ALERT_COOLDOWN_SECONDS=900
MONITOR_LOG_WINDOW=5m

# دامنه‌های HTTPS و روزهای یادآوری قبل از انقضای گواهی. برای هر گواهی، هر یادآوری
# فقط یک‌بار ارسال می‌شود و پس از تمدید، تاریخ جدید دوباره پایش خواهد شد.
MONITOR_SSL_HOSTS=kalam.tazesystem.ir,api.tazesystem.ir
MONITOR_SSL_REMINDER_DAYS=30,14,7,3,1

# در صورت تنظیم، پاسخ 5xx یا قطع اتصال این URL هم هشدار می‌دهد.
MONITOR_API_URL=https://api.tazesystem.ir/rest/v1/
