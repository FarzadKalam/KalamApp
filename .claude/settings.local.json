          {
            "type": "command",
            "command": "bash -c 'INPUT=$(cat); CMD=$(echo \"$INPUT\" | node -e \"process.stdin.resume();let d=``;process.stdin.on(`data`,c=>d+=c);process.stdin.on(`end`,()=>{try{console.log(JSON.parse(d).tool_input?.command||``)}catch{}})\"); if echo \"$CMD\" | grep -qE \"git[[:space:]]+commit\" && ! echo \"$CMD\" | grep -q \"\\-\\-no-verify\"; then cd /d/Kalamapp && npx tsc --noEmit --skipLibCheck 2>&1 | tail -20 | grep -i error && echo \"TypeScript errors found\" && exit 2; fi; exit 0'"
