# Frontend Supabase config
VITE_SUPABASE_URL=https://api.tazesystem.ir
VITE_SUPABASE_ANON_KEY=replace_with_real_anon_key
VITE_MAP_STYLE_URL=http://localhost:8081/styles/osm-bright/style.json
VITE_MAP_TILE_URL=http://localhost:8081/styles/osm-bright/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenMapTiles &copy; OpenStreetMap contributors
VITE_MAP_MAX_ZOOM=14

# Optional dedicated storage project/bucket for files (record_files / image uploads)
# If not set, app uses default storage on VITE_SUPABASE_URL and bucket `images`
# VITE_FILE_STORAGE_URL=https://your-storage-project.supabase.co
# VITE_FILE_STORAGE_ANON_KEY=your_storage_anon_key
# VITE_FILE_STORAGE_BUCKET=images

# Google Tag Manager — get from tagmanager.google.com
# VITE_GTM_ID=GTM-XXXXXXX

# Optional image transformation toggles.
# `VITE_ENABLE_IMAGE_TRANSFORM_PREVIEW` affects general UI preview URLs.
# `VITE_ENABLE_PRINT_IMAGE_TRANSFORM` only affects print/PDF image URLs and is safer to enable first.
# VITE_ENABLE_IMAGE_TRANSFORM_PREVIEW=false
# VITE_ENABLE_PRINT_IMAGE_TRANSFORM=true

# Server-side only (never expose in browser)
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Server-side AvalAI gateway for Edge Functions. Never expose these as VITE_ variables.
AVALAI_API_KEY=replace_with_avalai_api_key
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_FALLBACK_BASE_URLS=https://api.avalapis.ir/v1
AI_MODEL=gpt-5.4-mini

# Required for taxpayer_system Edge Function secret encryption.
# Set with `supabase secrets set TAXPAYER_SECRET_ENCRYPTION_KEY=...`.
TAXPAYER_SECRET_ENCRYPTION_KEY=replace_with_32_plus_char_random_secret

# Required for Instagram provider API-key encryption and public webhook generation.
# Use a unique random value of at least 32 characters. Do not change it after API keys are saved.
INSTAGRAM_SECRET_ENCRYPTION_KEY=replace_with_32_plus_char_random_secret
# Public API origin used in the webhook address given to the Instagram provider.
INSTAGRAM_WEBHOOK_PUBLIC_BASE_URL=https://api.tazesystem.ir
